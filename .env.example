# core-db — auth-db + festival-db + reservation-db, 하나의 MySQL 인스턴스(포트 3307)를
# 공유하고 스키마만 서로 분리합니다. 각 서비스는 자기 스키마에만 접속합니다.
AUTH_DB_HOST=localhost
AUTH_DB_PORT=3307
AUTH_DB_NAME=auth_db
AUTH_DB_USERNAME=auth_user
AUTH_DB_PASSWORD=auth_password
AUTH_DB_ROOT_PASSWORD=root_password

# festival-db (core-db 인스턴스 공유, 포트 3307)
# 이 계정/비밀번호를 바꾸면 mysql-init/core-db/01-festival-db.sql도 같이 맞춰야 합니다.
FESTIVAL_DB_HOST=localhost
FESTIVAL_DB_PORT=3307
FESTIVAL_DB_NAME=festival_db
FESTIVAL_DB_USERNAME=festival_user
FESTIVAL_DB_PASSWORD=festival_password

# reservation-db (core-db 인스턴스 공유, 포트 3307)
# 이 계정/비밀번호를 바꾸면 mysql-init/core-db/02-reservation-db.sql도 같이 맞춰야 합니다.
RESERVATION_DB_HOST=localhost
RESERVATION_DB_PORT=3307
RESERVATION_DB_NAME=reservation_db
RESERVATION_DB_USERNAME=reservation_user
RESERVATION_DB_PASSWORD=reservation_password

# reservation-service -> festival-service 동기 호출
# 로컬에서 각 서비스를 gradlew bootRun으로 직접 띄울 땐 localhost가 맞지만, docker compose로
# 배포할 땐 컨테이너 이름(festival-service)으로 접근해야 합니다 — docker-compose.yml의
# 각 서비스 environment: 블록이 이 값을 컨테이너용으로 덮어쓰므로, 배포 시엔 이 .env 값을
# 굳이 고치지 않아도 됩니다(고쳐도 무시됩니다).
FESTIVAL_SERVICE_URL=http://localhost:8082

# festival-service -> reservation-service 동기 호출(SEATED 티켓타입 좌석 생성)
# 위 FESTIVAL_SERVICE_URL과 동일한 이유로 로컬 실행 기준 localhost를 기본값으로 둡니다.
RESERVATION_SERVICE_URL=http://localhost:8083

# auth-service
JWT_SECRET=local-dev-jwt-secret-please-change-before-deploy

# festival-service -> auth-service 내부 Role 부여 호출(PUT /internal/v1/roles)
# auth-service의 internal.role-grant.token과 반드시 같은 값이어야 합니다. 배포 전 실제 값으로 교체하세요.
INTERNAL_AUTH_TOKEN=CHANGE_ME_IN_ENV

# festival-service -> reservation-service 좌석 생성 내부 호출(POST /internal/v1/seats) 인증 토큰
# reservation-service의 internal.reservation-service.token과 반드시 같은 값이어야 합니다. 배포 전 실제 값으로 교체하세요.
INTERNAL_RESERVATION_TOKEN=CHANGE_ME_IN_ENV

# payment-db (core-db 인스턴스 공유, 포트 3307)
# 이 계정/비밀번호를 바꾸면 mysql-init/core-db/03-payment-db.sql도 같이 맞춰야 합니다.
PAYMENT_DB_HOST=localhost
PAYMENT_DB_PORT=3307
PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USERNAME=payment_user
PAYMENT_DB_PASSWORD=payment_password

# PortOne V2 — 강사님이 배부한 교육용 테스트 채널 키. API Secret·Webhook Secret은
# 절대 프론트엔드에 전달하지 않고, 이 프로젝트에서는 팀별로 배부받은 실제 값을 로컬 .env에만 넣는다.
PORTONE_STORE_ID=CHANGE_ME_IN_ENV
PORTONE_CHANNEL_KEY_PAYMENT=CHANGE_ME_IN_ENV
PORTONE_CHANNEL_KEY_BILLING=CHANGE_ME_IN_ENV
PORTONE_API_SECRET=CHANGE_ME_IN_ENV
PORTONE_WEBHOOK_SECRET=CHANGE_ME_IN_ENV
# 가상계좌 데모 자동 입금 — 테스트 채널만 쓰는 동안 계좌 발급 후 N분이 지나면 입금된 것으로 처리한다.
# 실결제로 전환하면 반드시 false로 끌 것(실제 입금 없이 예매가 확정된다).
PAYMENT_DEMO_DEPOSIT_ENABLED=true
PAYMENT_DEMO_DEPOSIT_DELAY_MINUTES=30

# festival-service 이미지 업로드 저장 위치(호스트 쪽 경로).
# 컨테이너 내부 경로는 docker-compose.yml에서 /app/savedimage로 고정돼 있으므로
# 여기서는 호스트 서버의 실제 디렉터리만 지정하면 된다(상대경로면 docker-compose.yml 기준).
HOST_SAVED_IMAGE=/home/ubuntu/Final-Project-Team5/backend/festival-service/savedimage

# 도우미 초대 링크 및 이메일 발송 (auth-service)
FRONTEND_URL=http://localhost:5173
MAIL_USERNAME=sender@example.com
MAIL_APP_PASSWORD=CHANGE_ME_IN_ENV
APP_TIMEZONE=Asia/Seoul
HELPER_ACCOUNT_REVOKE_AFTER_HOURS=24
# Gateway도 HELPER 세션 검증에 위 INTERNAL_AUTH_TOKEN을 사용합니다.

# 아래 빈 항목은 사용할 때 값을 채웁니다. application.yaml 기본값을 쓰려면 해당 줄을 삭제하거나 주석 처리합니다.
# 내부 인증 서비스 주소(로컬 직접 실행 또는 컨테이너 주소).
AUTH_SERVICE_URL=
# Gateway가 결제 요청을 전달할 서비스 주소.
PAYMENT_SERVICE_URL=
# 이미지 파일을 저장할 서비스 내부 경로(컨테이너 실행 시 compose 설정 우선).
SAVED_IMAGE=

# 카카오 로그인 앱의 클라이언트 ID.
KAKAO_CLIENT_ID=
# 카카오 로그인 앱의 클라이언트 비밀 키.
KAKAO_CLIENT_SECRET=
# 카카오 로그인 완료 후 돌아올 콜백 주소.
KAKAO_REDIRECT_URI=
# 구글 로그인 앱의 클라이언트 ID.
GOOGLE_CLIENT_ID=
# 구글 로그인 앱의 클라이언트 비밀 키.
GOOGLE_CLIENT_SECRET=
# 구글 로그인 완료 후 돌아올 콜백 주소.
GOOGLE_REDIRECT_URI=

# 챗봇의 Gemini API 인증 키.
GEMINI_API_KEY=
# 챗봇에서 사용할 Gemini 모델 이름.
GEMINI_MODEL=
# 챗봇의 Gemini API 호출 주소.
GEMINI_BASE_URL=

# 페스티벌 좌표 백필(운영자 전용 API)에 쓰는 카카오 로컬 REST API 키 — 지도 JS 키(VITE_KAKAO_MAP_APP_KEY)와는
# 다른 키. 카카오맵 제품이 활성화된 앱의 REST API 키를 넣는다. 서버 전용이라 프론트에는 절대 노출하지 않는다.
KAKAO_MAP_REST_API_KEY=

# 팀별 결제 ID를 구분하는 접두어.
PAYMENT_ID_PREFIX=
# PortOne 서버 API 호출 주소.
PORTONE_API_BASE_URL=
# 사용자별 행사 구매 수량 상한.
RESERVATION_MAX_QUANTITY_PER_FESTIVAL=
# 행사 구매 수량 상한이 없을 때 참조하는 기존 설정 이름.
RESERVATION_MAX_QUANTITY_PER_TICKET_TYPE=
# 환불된 티켓 재고를 다시 공개하는 시각(시 단위).
REFUND_STOCK_RELEASE_HOUR=
# 행사 시작 전 참가자 환불을 마감하는 시간(시간 단위).
REFUND_CUTOFF_HOURS=
# 기존 QR 응답의 이미지 URL 생성 주소(프론트는 토큰으로 직접 그림).
QR_IMAGE_BASE_URL=
