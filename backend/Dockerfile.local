# syntax=docker/dockerfile:1
# 로컬 재현용(docker-compose.local.yml) 백엔드 이미지. 운영 Dockerfile은 CI가 만든 jar를 복사만 하지만,
# 새로 clone한 PC에서 docker compose 한 번으로 띄울 수 있도록 이미지 안에서 bootJar까지 빌드한다.
# 사용: docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build (SERVICE는 compose가 넘긴다)
FROM eclipse-temurin:21-jdk AS build
WORKDIR /workspace
COPY . .
ARG SERVICE
# Windows에서 clone해 줄바꿈이 CRLF로 바뀐 경우에도 gradlew가 돌도록 LF로 맞춘다.
RUN sed -i 's/\r$//' gradlew
RUN --mount=type=cache,target=/root/.gradle sh ./gradlew :${SERVICE}:bootJar -x test --no-daemon

FROM eclipse-temurin:21-jre
WORKDIR /app
ARG SERVICE
COPY --from=build /workspace/${SERVICE}/build/libs/*.jar app.jar
ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar app.jar"]
